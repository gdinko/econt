{
    "name": "gdinko/econt",
    "description": "Laravel Econt API Wrapper",
    "keywords": [
        "gdinko",
        "econt",
        "econt laravel",
        "laravel"
    ],
    "homepage": "https://github.com/gdinko/econt",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Dinko Georgiev",
            "email": "dinko359@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2|^8.3|^8.4",
        "guzzlehttp/guzzle": "^7.4",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "nunomaduro/collision": "^8.0",
        "nunomaduro/larastan": "^2.0|^3.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^2.0|^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0|^4.0",
        "phpstan/extension-installer": "^1.1",
        "phpstan/phpstan-deprecation-rules": "^1.0|^2.0",
        "phpstan/phpstan-phpunit": "^1.1|^2.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Gdinko\\Econt\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gdinko\\Econt\\Tests\\": "tests"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Gdinko\\Econt\\EcontServiceProvider"
            ],
            "aliases": {
                "Econt": "Gdinko\\Econt\\Facades\\Econt"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
